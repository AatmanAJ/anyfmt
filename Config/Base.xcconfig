#include "Brand.xcconfig"

MACOSX_DEPLOYMENT_TARGET = 13.0
ARCHS = arm64
ONLY_ACTIVE_ARCH = NO
SDKROOT = macosx

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
GCC_TREAT_WARNINGS_AS_ERRORS = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES

// Developer ID distribution, not the Mac App Store. Not sandboxed.
// Hardened runtime is ON for every Developer ID build (make dmg / release
// set HALO_HARDENED_RUNTIME=YES; notarization requires it). Local ad-hoc
// builds leave it off: library validation rejects ad-hoc-signed frameworks
// and dylibs ("different Team IDs"), so nothing would launch (D-031).
HALO_HARDENED_RUNTIME = NO
ENABLE_HARDENED_RUNTIME = $(HALO_HARDENED_RUNTIME)
ENABLE_APP_SANDBOX = NO
CODE_SIGN_STYLE = Manual
// Ad-hoc by default. `make dmg` overrides with DEVELOPER_ID when present.
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
OTHER_CODE_SIGN_FLAGS = --timestamp=none

CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0

DEAD_CODE_STRIPPING = YES
